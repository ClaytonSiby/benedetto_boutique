# Environment variables for production (GCP VM deployment)
# Copy this to .env.production and fill in your actual values

# App Settings
DEBUG=False
PROJECT_NAME=B Boutique API
API_V1_STR=/api/v1

# CORS Settings
BACKEND_CORS_ORIGINS=https://benedettoboutique.com,https://www.benedettoboutique.com

# Database Settings (Docker internal)
POSTGRES_USER=bboutique
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=b_boutique

# Redis Settings (Docker internal)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Security Settings (Generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here
SESSION_SECRET_KEY=your_session_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_COOKIE_NAME=b_boutique_session
SESSION_MAX_AGE=86400

# Google OAuth Settings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://benedettoboutique.com/api/v1/auth/google/callback
FRONTEND_URL=https://benedettoboutique.com

# Cloudinary Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
USE_CLOUDINARY=True

# SendGrid Email Settings
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@benedettoboutique.com
ADMIN_EMAIL=admin@benedettoboutique.com

# Stripe Payment Settings
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=ZAR

# Frontend Settings (for docker-compose)
NEXT_PUBLIC_API_URL=https://benedettoboutique.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
